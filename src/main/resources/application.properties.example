# Copy this file to application.properties (git-ignored) and adjust for your machine.
# Secrets come from environment variables, never from this file.
# Note: in .properties files a comment must be on its own line; text after a value is part of the value.

# --- Database (MySQL 8) ---
# allowPublicKeyRetrieval is needed for MySQL 8's default login method when SSL is off (local dev only).
spring.datasource.url=jdbc:mysql://localhost:3306/fixdesk?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kuala_Lumpur
spring.datasource.username=fixdesk
spring.datasource.password=${DB_PASSWORD}
# dev only: runs schema.sql and data.sql on every start. Set to never once the schema is stable.
spring.sql.init.mode=always

# --- Session ---
server.servlet.session.timeout=30m
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=strict

# --- Uploads ---
spring.servlet.multipart.max-file-size=5MB
# outside the web root and outside the jar
fixdesk.uploads.dir=../fixdesk-uploads

# --- Login and passwords (initial values, tune in testing) ---
fixdesk.security.login-max-failures=5
fixdesk.security.login-window-minutes=15
fixdesk.security.password-min-length=8

# --- Mail (Mailpit in development and demo) ---
spring.mail.host=localhost
spring.mail.port=1025

# --- AI (Module 3) ---
ollama.url=http://localhost:11434
ollama.model=llama3.2:3b
ollama.timeout.ms=8000

triage.min-queue=2
triage.aging.points-per-hour=1
triage.aging.max-points=20

# --- Escalation and alerts (Module 5); initial values, tune in testing ---
escalation.ack-timeout.life-safety.minutes=5
escalation.ack-timeout.access-critical.minutes=30
alerts.cooldown.minutes=10
alerts.max-per-user-per-day=3
ai-actions.expiry.minutes=10

# --- Agent API and voice call (bonus) ---
# Empty secret = the Agent API refuses every call.
agent.api.secret=${AGENT_API_SECRET:}
voice.agent.url=http://localhost:8081
campus.security.phone=TO_BE_CONFIRMED
