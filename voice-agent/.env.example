# Copy this file to .env and fill in your own values. Never commit .env.

# LiveKit Cloud project (cloud.livekit.io -> your project -> Settings -> API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local Ollama (the agent's "brain")
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# none = no thinking step (fast replies for voice)
OLLAMA_REASONING=none

# LiveKit Inference speech models ("ears" and "mouth")
STT_MODEL=deepgram/nova-3
TTS_MODEL=cartesia/sonic-3.6
TTS_VOICE=

# Call language: en (English), ms (Malay), or multi (English + Malay, mixed too;
# the agent replies in the language the caller used)
LANGUAGE=multi
